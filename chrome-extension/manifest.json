{
  "manifest_version": 3,
  "name": "PasteScribe",
  "version": "1.1.0",
  "description": "Escribe un texto pegado letra por letra en el campo de texto de la pestaña activa.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "PasteScribe",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
